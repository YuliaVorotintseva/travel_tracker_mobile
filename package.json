{
  "name": "travel_tracker_mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev-client": "expo start --dev-client --android",
    "ios": "expo run:ios",
    "ios:dev-client": "expo start --dev-client --ios",
    "prebuild": "expo prebuild --clean",
    "prebuild:clean": "expo prebuild --clean",
    "web": "expo start --web",
    "lint": "yarn run lint:eslint && yarn run lint:prettier",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:prettier": "prettier --check .",
    "lint:fix": "yarn run lint:eslint:fix && yarn run lint:prettier:fix",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:prettier:fix": "prettier --write .",
    "openapi": "yarn openapi:download && yarn openapi:generate",
    "openapi:download": "node ./scripts/download_openapi.js ./src/shared/types/api/openapi.json",
    "openapi:generate": "npx @openapitools/openapi-generator-cli@latest generate -i ./src/shared/types/api/openapi.json -g typescript-axios --skip-validate-spec --enable-post-process-file -o ./src/shared/types/api/generated",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "yarn lint:eslint:fix",
      "yarn lint:prettier:fix"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "^2.3.1",
    "@supabase/supabase-js": "^2.105.1",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^55.0.19",
    "expo-linking": "~8.0.11",
    "expo-location": "^55.1.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "^1.27.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^10.2.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "openapi-generator-cli": "^1.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
